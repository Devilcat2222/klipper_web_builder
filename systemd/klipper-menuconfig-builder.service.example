# Systemd service file for Klipper Menuconfig Builder
# Copy to /etc/systemd/system/klipper-menuconfig-builder.service
# and customize paths below. Then: sudo systemctl daemon-reload && sudo systemctl enable --now klipper-menuconfig-builder

[Unit]
Description=Klipper Menuconfig Builder
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/klipper_web_builder
ExecStart=/home/YOUR_USER/klipper-menuconfig-builder-env/bin/python /home/YOUR_USER/klipper_web_builder/server.py -k /home/YOUR_USER/klipper -l /home/YOUR_USER/printer_data/logs/menuconfig.log -c /home/YOUR_USER/klipper-kconfigs
Restart=always
RestartSec=5
